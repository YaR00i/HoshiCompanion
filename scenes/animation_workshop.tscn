[node name="EditorGuide" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("4")

[node name="Margin" type="MarginContainer" parent="EditorGuide"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 28

[node name="Steps" type="VBoxContainer" parent="EditorGuide/Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="EditorGuide/Margin/Steps"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "Мастерская анимаций Хоши"

[node name="Intro" type="Label" parent="EditorGuide/Margin/Steps"]
layout_mode = 2
autowrap_mode = 3
text = "Это сцена редактирования анимации sketch. Внизу — дорожки позы, блокнота и мелка. Хоши и все предметы появятся в отдельном окне после F6."

[node name="Step1" type="Label" parent="EditorGuide/Margin/Steps"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
autowrap_mode = 3
text = "1   Нажми F6 — откроется Хоши с предметами и панелью редактирования. Выбери 3 с для мелка или 8.2 с для блокнота."

[node name="Step2" type="Label" parent="EditorGuide/Margin/Steps"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
autowrap_mode = 3
text = "2   Справа выбери любой предмет сценки либо часть позы. Измени положение, поворот или масштаб; результат сразу виден на модели."

[node name="Step3" type="Label" parent="EditorGuide/Margin/Steps"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
autowrap_mode = 3
text = "3   Нажми «Сохранить анимацию». Для времени ключей и кривых можно использовать обычную панель AnimationPlayer внизу Godot; после Ctrl+S перечитай файл в мастерской."

[node name="Footnote" type="Label" parent="EditorGuide/Margin/Steps"]
layout_mode = 2
autowrap_mode = 3
text = "Новые зарегистрированные предметы появляются в мастерской автоматически. Таз и ноги Хоши остаются на опоре."
