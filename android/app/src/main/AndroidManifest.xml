<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Пульт открывается с ПК в домашней сети (http://<ПК>:18770). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Уведомления «Claude закончил ✓ / ждёт ответа ?». -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Связь с Хоши, пока телефон заблокирован (постоянное уведомление «Хоши на связи»). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- Автообновление: установить новую версию, скачанную с ПК (каждый раз — с подтверждением). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.Hoshi">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SettingsActivity" android:exported="false" />

        <service
            android:name=".HoshiService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- Плитки «Хоши 1…6» в быстрых настройках (что делают — выбирается в приложении). -->
        <service
            android:name=".QuickTile1"
            android:exported="true"
            android:icon="@drawable/ic_stat_hoshi"
            android:label="Хоши 1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".QuickTile2"
            android:exported="true"
            android:icon="@drawable/ic_stat_hoshi"
            android:label="Хоши 2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".QuickTile3"
            android:exported="true"
            android:icon="@drawable/ic_stat_hoshi"
            android:label="Хоши 3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".QuickTile4"
            android:exported="true"
            android:icon="@drawable/ic_stat_hoshi"
            android:label="Хоши 4"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".QuickTile5"
            android:exported="true"
            android:icon="@drawable/ic_stat_hoshi"
            android:label="Хоши 5"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".QuickTile6"
            android:exported="true"
            android:icon="@drawable/ic_stat_hoshi"
            android:label="Хоши 6"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
